# Copia a .env; nunca publiques secretos.
DB_URL=jdbc:postgresql://localhost:5433/agnostic_router
DB_USER=router
DB_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=router
RABBITMQ_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=120
CORS_ORIGIN=http://localhost:4200

AI_BASE_URL=http://localhost:8000
# Dentro de Docker: Laya en Windows/host por defecto.
# Si usas --profile ai, establece AI_BASE_URL_DOCKER=http://laya:8000
AI_BASE_URL_DOCKER=http://host.docker.internal:8000
AI_API_KEY=
# Clave maestra Base64 de 32 bytes para las API keys guardadas desde Angular.
# Generar una vez y conservarla junto con los respaldos; no es la clave del proveedor.
AI_CONFIG_ENCRYPTION_KEY=
# Independent Base64-encoded 32-byte key for SMTP credentials configured through Angular.
NOTIFICATION_ENCRYPTION_KEY=
AI_MODEL=multilingual
AI_LANG=es

ESPOCRM_DB_ROOT_PASSWORD=
ESPOCRM_DB_PASSWORD=
ESPOCRM_ADMIN_PASSWORD=
ESPOCRM_API_KEY=

# Gmail OAuth callback: http://localhost:4200/api/v1/gmail/oauth/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ENCRYPTION_KEY=
GMAIL_POLL_SECONDS=90
