# Copia a .env; nunca publiques secretos.
DB_URL=jdbc:postgresql://localhost:5433/agnostic_router
DB_USER=router
DB_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=router
RABBITMQ_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=120
CORS_ORIGIN=http://localhost:4200

AI_BASE_URL=http://localhost:8000
# Dentro de Docker: Laya en Windows/host por defecto.
# Si usas --profile ai, establece AI_BASE_URL_DOCKER=http://laya:8000
AI_BASE_URL_DOCKER=http://host.docker.internal:8000
AI_API_KEY=
AI_MODEL=multilingual
AI_LANG=es

ESPOCRM_DB_ROOT_PASSWORD=
ESPOCRM_DB_PASSWORD=
ESPOCRM_ADMIN_PASSWORD=
ESPOCRM_API_KEY=
