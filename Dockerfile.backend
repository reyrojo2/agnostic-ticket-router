FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre
ARG SERVICE
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70.0"
WORKDIR /app
COPY --from=build /workspace/${SERVICE}/target/${SERVICE}-0.2.0-SNAPSHOT.jar /app/app.jar
COPY notification-service/start-with-extra-ca.sh /app/start-with-extra-ca.sh
EXPOSE 8081 8082 8083 8084 8085 8088 8761 8090
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
