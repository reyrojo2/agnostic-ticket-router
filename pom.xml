<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>
    <groupId>com.agnosticrouter</groupId>
    <artifactId>agnostic-ticket-router</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AgnosticTicketRouter</name>
    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.48</lombok.version>
        <spring-cloud.version>2024.0.3</spring-cloud.version>
    </properties>
    <modules>
        <module>common-contracts</module>
        <module>eureka-server</module>
        <module>api-gateway</module>
        <module>mail-ingestion-service</module>
        <module>business-knowledge-service</module>
        <module>decision-engine-service</module>
        <module>crm-adapter-service</module>
        <module>notification-service</module>
        <module>demo-crm-service</module>
    </modules>
    <dependencyManagement>
      <dependencies>
        <dependency><groupId>org.springframework.cloud</groupId><artifactId>spring-cloud-dependencies</artifactId><version>${spring-cloud.version}</version><type>pom</type><scope>import</scope></dependency>
      </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
